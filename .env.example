# ============================================
# Licona Realty Platform - Environment Variables
# ============================================
# NEVER commit actual values. This file is a template only.
# All values stored exclusively in Vercel environment variables.
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google APIs
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret

# DocuSign (sandbox - use demo endpoints, not production)
DOCUSIGN_INTEGRATION_KEY=your-docusign-integration-key
DOCUSIGN_SECRET_KEY=your-docusign-secret-key
DOCUSIGN_ACCOUNT_ID=a83aa454-b34b-48ad-8b84-c659dd97b5a4
DOCUSIGN_BASE_URL=https://na4.docusign.net/restapi/v2.1
DOCUSIGN_OAUTH_URL=https://account.docusign.com
DOCUSIGN_HMAC_KEY=your-docusign-hmac-key

# Canva Connect
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret

# Meta (Instagram & Facebook)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
FACEBOOK_PAGE_ID=your-facebook-page-id

# Google Business Profile
GBP_API_KEY=your-gbp-api-key

# Encryption (for mortgage calculator PII)
ENCRYPTION_KEY=your-256-bit-encryption-key

# App
NEXT_PUBLIC_APP_URL=https://app.liconarealty.com
NEXT_PUBLIC_SITE_URL=https://liconarealty.com
